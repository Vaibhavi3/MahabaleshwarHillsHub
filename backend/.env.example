# Database
DATABASE_URL=postgresql://mahabaleshwar_user:secure_password_123@localhost/mahabaleshwar_hub

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Seed script - creates one admin user on first run
ADMIN_EMAIL=admin@mahabaleshwarhillshub.com
ADMIN_PASSWORD=change-this-password
ADMIN_USERNAME=admin

# Email (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password